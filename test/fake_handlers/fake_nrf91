#!/bin/sh
# fake_nrf91 -- stand-in for mcumgr_uart, same purpose and conventions as
# fake_a55 (see that file's header comment). Test-only scaffolding.
set -eu

: "${NEXREV_FAKE_STATE_DIR:?NEXREV_FAKE_STATE_DIR must be set (the test harness sets this)}"
STATE_FILE="$NEXREV_FAKE_STATE_DIR/.fake-nrf91-installed-version"
STAGED_FILE="$NEXREV_FAKE_STATE_DIR/.fake-nrf91-staged-version"

case "${1:-}" in
  is-installed)
    [ -r "$STATE_FILE" ] && cat "$STATE_FILE" || true
    ;;
  install)
    echo "fake_nrf91: (pretending to) upload $2 over UART" >&2
    cp "$2" "$STAGED_FILE"
    ;;
  apply)
    echo "fake_nrf91: (pretending to) test-boot + wait for SMP" >&2
    mv "$STAGED_FILE" "$STATE_FILE"
    ;;
  commit)
    echo "fake_nrf91: (pretending to) image confirm" >&2
    ;;
  *)
    echo "usage: fake_nrf91 {is-installed|install <file> <sha256>|apply|commit}" >&2
    exit 2
    ;;
esac
